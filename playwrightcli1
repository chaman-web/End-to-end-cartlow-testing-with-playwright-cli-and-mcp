[{\"name\": \"__selected_country\", \"value\": \"intl\",\n                          \"domain\": \"stage.cartlow.com\", \"path\": \"/\"}])\n    hp = HomePage(page)\n    hp.open(INTL_URL)\n    context.close()\n\n    assert len(errors) == 0, f\"Critical console errors found: {errors}\"\n    print(f\"\\n   ✅ INTL-002 PASSED — no critical console errors\")\n\n\ndef test_intl_003_only_gift_cards(home: HomePage):\n    \"\"\"INTL-003 — Verify only Gift Cards are displayed on INTL homepage.\"\"\"\n    body = home.body_text().lower()\n    assert \"gift card\" in body, \"Gift Cards section not found on INTL homepage\"\n\n    physical_terms = [\"refurbished\", \"used device\", \"grade a\", \"grade b\", \"grade c\"]\n    found = [t for t in physical_terms if t in body]\n    assert not found, f\"Physical product terms found on INTL homepage: {found}\"\n    print(f\"\\n   ✅ INTL-003 PASSED — only Gift Cards displayed\")\n\n\ndef test_intl_004_currency_usd(home: HomePage):\n    \"\"\"INTL-004 — Verify currency is USD ($) on INTL channel.\"\"\"\n    price_els = home.page.evaluate(\"\"\"\n        () => [...document.querySelectorAll('*')]\n            .filter(e => e.children.length === 0 && e.offsetParent !== null\n                && /\\\\$\\\\s*[\\\\d]/.test(e.innerText) && e.innerText.trim().length < 30)\n            .map(e => e.innerText.trim()).slice(0, 5)\n    \"\"\")\n    assert len(price_els) > 0 or \"$\" in home.body_text(), \\\n        \"USD ($) price symbol not found on INTL homepage\"\n    print(f\"\\n   Price samples: {price_els[:3]}\")\n    print(f\"   ✅ INTL-004 PASSED — currency is USD ($)\")\n\n\ndef test_intl_005_language_english(home: HomePage):\n    \"\"\"INTL-005 — Verify language is English on INTL channel.\"\"\"\n    lang = home.page.evaluate(\"() => document.documentElement.lang\")\n    assert lang.startswith(\"en\"), f\"HTML lang='{lang}', expected 'en'\"\n    assert \"/en\" in home.page.url, f\"Expected /en in URL, got: {home.page.url}\"\n    direction = home.page.evaluate(\"() => document.documentElement.dir\")\n    assert direction != \"rtl\", \"Page direction is RTL — expected LTR\"\n    print(f\"\\n   ✅ INTL-005 PASSED — language is English\")\n",
